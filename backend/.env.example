DATABASE_URL=postgresql+psycopg://freelance:freelance@localhost:5433/freelance

# Maintenance reminders. Leave the webhook URL empty to turn reminders off.
# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# Your Discord user ID, @mentioned in each reminder. Turn on Developer Mode
# (User Settings > Advanced), then right-click your name > Copy User ID.
DISCORD_MENTION_USER_ID=

# Discord profile sync: shows the names and avatars of clients' Discord contacts, and yours
# (DISCORD_MENTION_USER_ID) on the Maintenance page. Leave empty to turn it off.
# discord.com/developers/applications > New Application > Bot > Reset Token, then copy it here.
# No intents, permissions or server invite are needed to look users up by ID.
DISCORD_BOT_TOKEN=

# Login. The scrypt hash of the dashboard password; without it nobody can log in. Make one with
#   uv run python -m app.passwords hash-password
# and keep the single quotes, so the $ signs stay literal. A new hash logs out every session.
AUTH_PASSWORD_HASH=
# The session cookie's Domain. In production, with the frontend and the API on sibling
# subdomains (dash.example.com and api.example.com), set the parent: .example.com
# Leave empty for a host-only cookie, which is right for development through the Vite proxy.
COOKIE_DOMAIN=
# Send the session cookie over HTTPS only. Set to false for development over plain HTTP.
COOKIE_SECURE=true
# The frontend's origin when it calls the API cross-origin, e.g. https://dash.example.com
# (comma-separate several). Enables CORS with credentials for it and lets it pass the
# cross-site write check. Leave empty in development: the Vite proxy makes it same-origin.
FRONTEND_ORIGIN=

# The API's public URL, e.g. https://api.example.com. MCP clients connect to <PUBLIC_URL>/mcp and
# sign in with OAuth against it. Defaults to http://localhost:8000 for development.
PUBLIC_URL=
