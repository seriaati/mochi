# Settings for docker-compose.yml. Copy to .env next to it. For running the API on its own, see
# backend/.env.example instead.

# Login. The scrypt hash of the dashboard password; without it nobody can log in. Make one with
#   docker compose run --rm --no-deps --entrypoint python backend -m app.passwords hash-password
# and keep the single quotes, so the $ signs stay literal. A new hash logs out every session.
AUTH_PASSWORD_HASH=''

# Encrypts the Discord webhook URL, bot token and Keni API token: any random string of 32+
# characters, e.g.
#   openssl rand -base64 32
# Without it, none can be saved. A new key means entering them again.
ENCRYPTION_KEY=

# Where you open the app, e.g. https://dash.example.com. MCP clients connect to <APP_URL>/mcp.
APP_URL=http://localhost:8080
# The port on this machine the app listens on.
PORT=8080
# Send the session cookie over HTTPS only. Browsers make an exception for http://localhost; set to
# false to use the app over plain HTTP from anywhere else.
COOKIE_SECURE=true
