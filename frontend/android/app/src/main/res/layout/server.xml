<?xml version="1.0" encoding="utf-8"?>
<!-- ServerActivity: the Mochi server's address, or why it can't be reached. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="72dp"
        android:paddingEnd="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:src="@drawable/mochi" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/server_title"
            android:textColor="@color/ink"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/server_text"
            android:textColor="@color/dim"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:autofillHints=""
            android:background="@drawable/server_field"
            android:hint="@string/server_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/dim"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/go"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/server_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/server_continue"
            android:textAllCaps="false"
            android:textColor="@color/on_hero"
            android:textSize="16sp" />

        <Button
            android:id="@+id/change"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/server_change"
            android:textAllCaps="false"
            android:textColor="@color/dim"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
