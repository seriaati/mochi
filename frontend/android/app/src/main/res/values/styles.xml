<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Also behind the status and navigation bars, until the page sets their color (MochiPlugin). -->
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- The splash screen: the mark on the ground, light or dark as the app is (MochiPlugin
         setSystemBars gives Android the theme picked in the web app). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- The screen that asks for the server (ServerActivity): ink cursor and handles, and a status
         bar on the ground before Android 15 draws it see-through (else it's AppCompat's grey). -->
    <style name="AppTheme.Server" parent="AppTheme.NoActionBar">
        <item name="colorAccent">@color/ink</item>
        <item name="colorControlActivated">@color/ink</item>
        <item name="android:statusBarColor">@color/bg</item>
    </style>
</resources>
