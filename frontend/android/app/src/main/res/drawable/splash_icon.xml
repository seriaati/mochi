    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.63"
        android:scaleY="0.63"
        android:translateX="22.5"
        android:translateY="22.5">
        <path
            android:fillColor="@color/mark_ground"
            android:pathData="M34,0H66A34,34 0,0 1,100 34V66A34,34 0,0 1,66 100H34A34,34 0,0 1,0 66V34A34,34 0,0 1,34 0Z" />
        <path
