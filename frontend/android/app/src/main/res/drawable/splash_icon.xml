            android:pathData="M23.1,74a26.9,3.8 0,1 0,53.8 0a26.9,3.8 0,1 0,-53.8 0Z" />
        <path
            android:fillColor="@color/mark_mochi"
            android:pathData="M22,64.2C22,43.2 34.9,31 50,31C65.1,31 78,43.2 78,64.2C78,70.9 71.3,73 50,73C28.7,73 22,70.9 22,64.2Z"
            android:strokeColor="@color/mark_outline"
