        <path
            android:fillColor="@color/mark_face"
            android:pathData="M39.6,54.9a2.4,2.4 0,1 0,4.8 0a2.4,2.4 0,1 0,-4.8 0ZM55.6,54.9a2.4,2.4 0,1 0,4.8 0a2.4,2.4 0,1 0,-4.8 0Z" />
        <path
            android:fillColor="@color/mark_blush"
            android:pathData="M31.2,60.4a3.6,2 0,1 0,7.2 0a3.6,2 0,1 0,-7.2 0ZM61.6,60.4a3.6,2 0,1 0,7.2 0a3.6,2 0,1 0,-7.2 0Z" />
    </group>
</vector>
