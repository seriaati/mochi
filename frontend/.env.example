# The API's origin, for a build served apart from the API (e.g. on Cloudflare Pages, set it in
# the project's build environment variables). Leave empty in development: the Vite dev server
# proxies /api to localhost:8000.
VITE_API_URL=https://api.example.com

# Only for the public demo's build: the login screen shows this password and fills it in.
# VITE_DEMO_PASSWORD=mochi
