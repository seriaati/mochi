server {
    listen 80;
    root /usr/share/nginx/html;

    # The API, and the MCP endpoint with the OAuth routes its clients sign in with (see the end of
    # backend/app/main.py). Serving them from this origin keeps the session cookie first-party.
    location ~ ^/(api|mcp|\.well-known|authorize|token|register|revoke)(/|$) {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        # Keeps the browser's Host, so the API sees requests from this page as same-origin.
        proxy_set_header Host $http_host;
        # Replaced, not appended to, so a client can't pick the IP the login throttle sees.
        proxy_set_header X-Forwarded-For $remote_addr;
        # MCP streams its responses.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Hashed file names: a new build gets new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes get the app. Revalidated, so a new build is picked up on the next visit.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
